# llm-workspace configuration.
# Everything is optional: ./start.sh works with these defaults.
# To change something: cp workspace.env.example workspace.env  (workspace.env is git-ignored)

# --- App -------------------------------------------------------------------
# Port of the web UI on this machine: http://localhost:<port>
LLM_WORKSPACE_PORT=3000
# Model pulled on first start. Needs tool calling for the MCP tools (qwen3, llama3.1, llama3.2...).
LLM_MODEL=qwen3:4b
# Set to 1 to skip pulling LLM_MODEL.
SKIP_MODEL_PULL=0
# Where the container reaches Ollama.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Spotify MCP server ----------------------------------------------------
SPOTIFY_MCP_PORT=8765
# Optional: enables search results, "now playing" and direct playback (Premium).
# Create an app at https://developer.spotify.com/dashboard, add the redirect URI
# below to it, paste its Client ID here, then run once:
#   cd mcp-servers/spotify && uv run spotify-mcp-login
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8766/callback
